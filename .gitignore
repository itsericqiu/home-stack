env.local
*.log
portable/home-stack/home-stack/
portable/home-stack/bin/
node_modules/
vendor/
.DS_Store
.worktrees/
portable/home-stack/bin/caddy-cloudflare

# Real profiles are the owner's; keep yours in your own dotfiles (docs/PUBLIC_RELEASE.md §4).
# No trailing slash: a real profile may be a symlink into the owner's dotfiles.
profiles/*
!profiles/default/
# Generated by home-stack-admin sync from the active profile.
portable/home-stack/Caddyfile
portable/home-stack/catalog.json
portable/home-stack/launchd/**/*.plist
# Per-machine Claude Code settings.
.claude/settings.local.json

# Compiled admin binary (rebuilt by `hs sync` and `run-admin.sh`).
portable/home-stack/admin/home-stack-admin

# Ephemeral/tool artifacts — avoid committing large VM images or agent state.
.omg/
tart.tar.gz
