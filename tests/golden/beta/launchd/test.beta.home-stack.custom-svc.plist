<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>test.beta.home-stack.custom-svc</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/my-app</string>
		<string>--port</string>
		<string>32003</string>
		<string>--config</string>
		<string>__WORK__/owner-beta/config.json</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>APP_MODE</key>
		<string>production</string>
		<key>HOME_STACK_DATA_DIR</key>
		<string>__WORK__/owner-beta/.config/home-stack/data/custom-svc</string>
		<key>HOME_STACK_PROFILE</key>
		<string>beta</string>
		<key>HOME_STACK_SELF_HOST</key>
		<string>custom.home.beta.test</string>
		<key>HOME_STACK_SELF_NAME</key>
		<string>custom-svc</string>
		<key>HOME_STACK_SELF_URL</key>
		<string>https://custom.home.beta.test</string>
		<key>LOG_LEVEL</key>
		<string>info</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__WORK__/owner-beta/.config/home-stack/logs/custom-svc.launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>__WORK__/owner-beta/.config/home-stack/logs/custom-svc.launchd.err.log</string>
</dict>
</plist>