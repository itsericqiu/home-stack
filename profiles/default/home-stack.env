# Starter profile for home-stack. Copy this directory to profiles/<your-name>/
# via `hs init` and fill in the placeholders. This file is NEVER auto-loaded;
# it exists only as a template for new profiles.
#
# Secrets belong in ~/.config/home-stack/env.local, never in this profile.

# === Mandatory ===
HOME_STACK_PARENT_DOMAIN=home.example.com
HOME_STACK_TAILNET_IP=100.64.0.8
HOME_STACK_ACME_EMAIL=admin@example.com
HOME_STACK_OWNER_HOME=/Users/REPLACE_ME
HOME_STACK_IDENTIFIER_PREFIX=com.example
HOME_STACK_ADMIN_USERNAME=admin

# === Optional ===
HOME_STACK_OPENCODE_PORT=31496
HOME_STACK_OPENCHAMBER_PORT=31497
HOME_STACK_ADMIN_PORT=31510
HOME_STACK_HERMES_PORT=31511
HOME_STACK_HERMES_DASHBOARD_USERNAME=admin

# Identity layer. Ports are non-secret and belong here; the subdomain lives in
# the registry (services.yaml), and the encryption key, broker secret and OIDC
# client credentials go in env.local.
HOME_STACK_POCKET_ID_PORT=31520
HOME_STACK_TINYAUTH_PORT=31521

# Pocket ID's own settings -- email/SMTP, app name, session duration, signup
# policy -- are configured in its admin UI, not here. home-stack does not model
# an app's internal configuration.
