# Home Stack profile template
# Tracked, non-secret, per-machine identity configuration.
# Copy this to profiles/<name>/home-stack.env and fill in mandatory vars.
# The loader fails fast and lists every missing key if any mandatory var is absent.

# === Mandatory ===
# These MUST be set. The loader fails fast and lists every missing key if absent.

HOME_STACK_PARENT_DOMAIN=             # e.g. home.example.com — apex for all stack subdomains
HOME_STACK_TAILNET_IP=                # e.g. 100.64.0.8 — Tailnet IP this Caddy binds to
HOME_STACK_ACME_EMAIL=                # e.g. admin@example.com — passed to Caddy global block
HOME_STACK_OWNER_HOME=                # e.g. /Users/jane — used for launchd plists, log paths, owner-relative roots
HOME_STACK_IDENTIFIER_PREFIX=         # e.g. com.example — prefix for launchd labels and plist filenames
HOME_STACK_ADMIN_USERNAME=            # e.g. admin — Admin Basic Auth username (password is in env.local)

# === Optional ===
# Engine substitutes the documented default when absent.

# HOME_STACK_REMOTE_DOMAIN=           # default: remote.${HOME_STACK_PARENT_DOMAIN}
# HOME_STACK_ADMIN_PORT=31510
# HOME_STACK_OPENCODE_PORT=31496
# HOME_STACK_OPENCHAMBER_PORT=31497
# HOME_STACK_HERMES_PORT=31511
# HOME_STACK_HERMES_DASHBOARD_USERNAME=admin
# HOME_STACK_BIN_DIR=                 # default: ${HOME_STACK_OWNER_HOME}/bin

# A service's presence in the registry (services.yaml) plus its own
# `enabled:` field is the toggle for whether it runs -- there is no separate
# profile flag. See docs/SERVICE_INTERFACE.md §4c.
