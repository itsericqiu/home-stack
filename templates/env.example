# Home Stack secrets template
# Real secrets must be provided in ~/.config/home-stack/env.local
#
# IMPORTANT: Identity configuration (domains, ports, usernames, IPs, paths) belongs in
# profiles/<name>/home-stack.env, NEVER here. The loader rejects any identity keys
# appearing in this file and fails with a clear error message.

# Cloudflare for DNS-01 certificates (token must have restricted scope)
HOME_STACK_CLOUDFLARE_API_TOKEN="your-token-here"

# Admin Basic Auth password (username is in the profile)
HOME_STACK_ADMIN_PASSWORD="your-admin-password"

# OpenCode server password for local OpenCode authentication (required when
# the opencode service is registered in services.yaml)
HOME_STACK_OPENCODE_SERVER_PASSWORD="your-opencode-password"

# OpenChamber UI password (required when the openchamber service is
# registered in services.yaml)
HOME_STACK_OPENCHAMBER_UI_PASSWORD="your-openchamber-password"

# Hermes dashboard auth (generate these during the reviewed install flow).
# Keep the scrypt hash and stable signing secret in env.local, never the profile.
HOME_STACK_HERMES_DASHBOARD_PASSWORD_HASH=
HOME_STACK_HERMES_DASHBOARD_SECRET=

# === Identity layer (optional; see docs/RUNBOOK.md) ===

# Pocket ID data-at-rest encryption key. At least 16 bytes; generate with
#   openssl rand -hex 32
HOME_STACK_POCKET_ID_ENCRYPTION_KEY=

# tinyauth session signing secret: openssl rand -hex 32
HOME_STACK_TINYAUTH_SECRET=

# tinyauth local break-glass account, as username:bcrypt-hash. Generate with
#   tinyauth user create --username admin --password '<password>'
# Store only the hash here; keep the plaintext in your Keychain.
HOME_STACK_TINYAUTH_USERS=

# OIDC client tinyauth uses to reach Pocket ID. Register it in Pocket ID with
# callback https://<tinyauth-host>/api/oauth/callback/pocketid
HOME_STACK_TINYAUTH_OIDC_CLIENTID=
HOME_STACK_TINYAUTH_OIDC_CLIENTSECRET=

# Optional: Tailscale control-plane API token for tinyauth's own tailnet
# detection. NOT needed for `auth: tailnet`, which uses the local WhoIs API.
HOME_STACK_TINYAUTH_TAILSCALE_APITOKEN=
HOME_STACK_TINYAUTH_TAILNET=

# Proves to Admin that a request arrived through the ingress rather than
# straight to its loopback port. Without it Admin ignores identity headers and
# falls back to Basic Auth. Rotating it requires restarting Caddy, not just a
# reload: openssl rand -hex 32
HOME_STACK_ADMIN_PROXY_SECRET=

# Hermes' own OIDC client, registered directly in Pocket ID with callback
# https://<hermes-host>/auth/callback (the path is validated). The issuer is
# derived from the profile. Omit the secret for a public (PKCE-only) client.
HOME_STACK_HERMES_OIDC_CLIENT_ID=
HOME_STACK_HERMES_OIDC_CLIENT_SECRET=

